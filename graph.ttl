    ex:arrivesAt <http://example.org/mkr/city/Krakow> ;
    ex:departsFrom <http://example.org/mkr/city/Prague> ;
    ex:departureDate "2026-06-18"^^xsd:date ;
    ex:durationMin 274 ;
    ex:operatedBy <http://example.org/mkr/airline/Lumen_Air> .

<http://example.org/mkr/flight/FL-8071> a ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Lviv> ;
