@prefix ex: <http://example.org/mkr/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Airline a rdfs:Class .

ex:BudgetFlight a rdfs:Class ;
    rdfs:subClassOf ex:Flight .

ex:City a rdfs:Class .

ex:Country a rdfs:Class .

ex:Flight a rdfs:Class .

ex:LongFlight a rdfs:Class ;
    rdfs:subClassOf ex:Flight .

ex:arrivesAt a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range ex:City .

ex:departsFrom a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range ex:City .

ex:departureDate a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:date .

ex:durationMin a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:integer .

<http://example.org/mkr/flight/FL-1633> a ex:Flight ;
    ex:arrivesAt <http://example.org/mkr/city/Tallinn> ;
    ex:departsFrom <http://example.org/mkr/city/Budapest> ;
    ex:departureDate "2026-08-19"^^xsd:date ;
    ex:durationMin 112 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/TransCarpa> .

<http://example.org/mkr/flight/FL-1747> a ex:Flight ;
    ex:arrivesAt <http://example.org/mkr/city/Lviv> ;
