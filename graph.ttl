    ex:arrivesAt <http://example.org/mkr/city/Paris> ;
    ex:departsFrom <http://example.org/mkr/city/Vilnius> ;
    ex:departureDate "2026-07-08"^^xsd:date ;
    ex:durationMin 169 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/Zephyr_Lines> .

ex:locatedIn a rdf:Property ;
    rdfs:domain ex:City ;
    rdfs:range ex:Country .

ex:operatedBy a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range ex:Airline .

ex:priceEur a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:decimal .

<http://example.org/mkr/stmt/FL-1035-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/=FlightLog> ;
    rdf:object 90 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-1035> .

<http://example.org/mkr/stmt/FL-1520-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/=AirWatch> ;
    rdf:object 55 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-1520> .

<http://example.org/mkr/stmt/FL-1546-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/=FlightLog> ;
    rdf:object 55 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-1546> .

<http://example.org/mkr/stmt/FL-6744-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/=AirWatch> ;
    rdf:object 40 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-6744> .

<http://example.org/mkr/stmt/FL-8264-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/=FlightLog> ;
    rdf:object 25 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-8264> .

